# Supabase project settings → Data API. The anon key is public by design: the
# database only exposes kept articles and active feeds to it (see packages/db/README.md).
# Leave both unset to run against the bundled sample data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
