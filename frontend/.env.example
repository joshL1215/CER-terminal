# Supabase project settings → Data API. The anon key is public by design: the
# database only exposes kept articles and active feeds to it (see packages/db/README.md).
# Copy to frontend/.env.local for local development, then restart Vite.
# Use the same names as GitHub Actions secrets (or variables) for CI builds.
# Vite embeds these public settings at build time; DATABASE_URL is backend-only.
# Leave BOTH unset to run against the bundled sample data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
